{
  "model_deployments": {
    "baseline": {
      "name": "Baseline MoE Deployment",
      "description": "Traditional approach with colocated experts",
      "configuration": {
        "model": {
          "type": "Mixture-of-Experts",
          "layers": 4,
          "experts_per_layer": 16,
          "total_experts": 64,
          "expert_type": "MLP",
          "precision": "FP16",
          "mha_heads": 16,
          "mha_head_dim": 512,
          "mlp_hidden_size": 32768
        },
        "parallelism": {
          "tensor_parallel": 8,
          "pipeline_parallel": 2,
          "expert_parallel": 2,
          "data_parallel": 1
        },
        "hardware": {
          "gpus": 16,
          "gpu_type": "H100",
          "per_gpu_experts": 4,
          "per_gpu_tensor_shard": "1/8"
        },
        "deployment_strategy": {
          "placement": "colocated_experts",
          "experts_per_gpu": 4,
          "pipeline_stages": 2,
          "gpus_per_stage": 8,
          "communication": "synchronous"
        },
        "performance": {
          "tps": 120000,
          "tpot_ms": 8.3,
          "batch_size": 1024
        }
      }
    },
    "proposed": {
      "name": "Large-Scale Cross-Node Expert Parallelism",
      "description": "One expert per GPU with cross-node distribution",
      "configuration": {
        "model": {
          "type": "Mixture-of-Experts",
          "layers": 4,
          "experts_per_layer": 16,
          "total_experts": 64,
          "expert_type": "MLP",
          "precision": "FP16",
          "mha_heads": 16,
          "mha_head_dim": 512,
          "mlp_hidden_size": 32768
        },
        "parallelism": {
          "tensor_parallel": 1,
          "pipeline_parallel": 1,
          "expert_parallel": 64,
          "data_parallel": 1,
          "optional_tensor_parallel": 2
        },
        "hardware": {
          "gpus": 64,
          "gpu_type": "H100",
          "per_gpu_experts": 1,
          "network": "NVLink/InfiniBand/NVSwitch"
        },
        "deployment_strategy": {
          "placement": "single_expert_per_gpu",
          "topology_aware": true,
          "cross_node": true,
          "communication": {
            "type": "asynchronous",
            "libraries": ["NCCL", "MPI"],
            "overlap_compute": true,
            "token_batching": true,
            "cuda_streams": true
          },
          "routing": {
            "mechanism": "dynamic_gating",
            "top_k": "standard",
            "load_balancing": "dynamic_probability_adjustment",
            "asynchronous_routing": true
          }
        },
        "pipeline_scheduling": {
          "type": "micro_stage_per_layer",
          "overlap_layers": true,
          "partial_batch_processing": true
        },
        "scalability": {
          "large_ep_threshold": 16,
          "current_ep": 64,
          "scaling_behavior": "near_linear"
        },
        "performance": {
          "tps": 450000,
          "tpot_ms": 2.2,
          "batch_size": 1024,
          "speedup_vs_baseline": 3.75,
          "latency_reduction": 3.8
        }
      }
    }
  },
  "implementation_details": {
    "expert_placement_algorithm": {
      "input": ["cluster_topology", "bandwidth_matrix", "gpu_memory_capacity", "expected_routing_patterns"],
      "output": "expert_to_gpu_mapping",
      "constraints": ["one_expert_per_gpu", "minimize_cross_node_traffic", "balance_memory_usage"]
    },
    "communication_overlap": {
      "cuda_streams": {
        "compute_stream": "default",
        "communication_stream": "high_priority",
        "synchronization": "event_based"
      },
      "token_routing": {
        "batching_threshold": "dynamic",
        "buffer_size": "tunable",
        "priority": "load_balanced"
      }
    },
    "memory_management": {
      "tensor_parallel_fallback": {
        "condition": "expert_size > gpu_memory",
        "tp_degree": 2,
        "implementation": "intra_expert_sharding"
      }
    }
  },
  "deployment_commands": {
    "baseline": {
      "launcher": "torchrun",
      "parameters": {
        "nproc_per_node": 8,
        "nnodes": 2,
        "node_rank": "$RANK",
        "master_addr": "$MASTER_ADDR",
        "master_port": "$MASTER_PORT",
        "parallel_config": "tp=8,pp=2,ep=2"
      }
    },
    "proposed": {
      "launcher": "torchrun",
      "parameters": {
        "nproc_per_node": 8,
        "nnodes": 8,
        "node_rank": "$RANK",
        "master_addr": "$MASTER_ADDR",
        "master_port": "$MASTER_PORT",
        "parallel_config": "tp=1,pp=1,ep=64",
        "enable_async_comm": true,
        "topology_aware": true
      }
    }
  }
}