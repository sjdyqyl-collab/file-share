    ],
    "setup_steps": [
      "1. Initialize NCCL communicator across 64 GPUs",
      "2. Create 4 process groups for pipeline parallelism",
      "3. Create 16 process groups for expert parallelism",
      "4. Load expert weights to assigned GPUs",
      "5. Initialize token buffers (16MB per GPU)",
      "6. Setup CUDA streams for compute/communication overlap",
      "7. Warmup communication patterns"
    ],
    "monitoring": {
      "metrics": ["gpu_utilization", "memory_usage", "network_bandwidth", "token_distribution"],
