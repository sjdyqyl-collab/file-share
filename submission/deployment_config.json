{
  "models": {
    "proposed_method": {
      "name": "Two-Level Attention Partitioning",
      "description": "Novel partitioning method combining head-wise and intra-head dimension-wise splitting",
      "partitioning_strategy": {
        "type": "two_level",
        "head_partitioning": {
          "n": 4,
          "heads_per_group": 4,
          "description": "Split 16 total heads into 4 groups, each handling 4 heads"
        },
        "dimension_partitioning": {
          "m": 4,
          "dimensions_per_slice": 128,
          "description": "Split each head's 512 dimensions into 4 slices of 128 dimensions each"
        },
        "total_partitions": 16,
        "total_devices": 16,
        "mapping": "one-to-one"
      },
      "tensor_dimensions": {
        "batch_size": 1024,
        "sequence_length": "variable",
        "embedding_dimension": 8192,
        "num_heads": 16,
        "head_dimension": 512,
        "mlp_hidden_size": 32768
      },
      "weight_matrices": {
        "Q_projection": {
          "shape": [8192, 8192],
          "partitioning": "block_matrix",
          "block_shape": [2048, 2048],
          "total_blocks": 16
        },
        "K_projection": {
          "shape": [8192, 8192],
          "partitioning": "block_matrix",
          "block_shape": [2048, 2048],
          "total_blocks": 16
        },
        "V_projection": {
          "shape": [8192, 8192],
          "partitioning": "block_matrix",
          "block_shape": [2048, 2048],
          "total_blocks": 16
        }
      },
      "computation_flow": {
        "step1_input_distribution": {
          "description": "Distribute input tensor X to all 16 devices",
          "communication": "broadcast",
          "data_shape_per_device": [1024, "L", 512]
        },
        "step2_local_projection": {
          "description": "Each device computes local Q, K, V projections",
          "computation": "matrix_multiply",
          "input_shape": [1024, "L", 512],
          "weight_shape": [2048, 2048],
          "output_shape": [1024, "L", 512]
        },
        "step3_attention_computation": {
          "description": "Compute scaled dot-product attention locally",
          "computation": "attention",
          "scale_factor": 22.6274,
          "output_shape": [1024, "L", 128]
        },
        "step4_intra_group_concatenation": {
          "description": "Concatenate dimension slices within each head group",
          "groups": 4,
          "devices_per_group": 4,
          "communication": "all_gather",
          "output_shape_per_group": [1024, "L", 512]
        },
        "step5_inter_group_concatenation": {
          "description": "Concatenate head groups to form final output",
          "communication": "all_gather",
          "final_output_shape": [1024, "L", 8192]
        }
      },
      "communication_pattern": {
        "hierarchical": true,
        "intra_group_bandwidth": "high",
        "inter_group_bandwidth": "high",
        "total_communication_rounds": 2
      }
    },
    "baseline_tensor_parallel": {
      "name": "Tensor Parallelism + Pipeline Parallelism",
      "description": "Conventional baseline using TP=8 and PP=2",
      "parallelism_strategy": {
        "tensor_parallelism": {
          "degree": 8,
          "split_dimension": "hidden",
          "description": "Split model parameters across 8 GPUs"
        },
        "pipeline_parallelism": {
          "degree": 2,
          "stages": 2,
          "description": "Split model layers across 2 pipeline stages"
        },
        "total_devices": 16,
        "mapping": "TP×PP"
      },
      "tensor_dimensions": {
        "batch_size": 1024,
        "sequence_length": "variable",
        "embedding_dimension": 8192,
        "num_heads": 16,
        "head_dimension": 512,
        "mlp_hidden_size": 32768
      },
      "weight_distribution": {
        "per_device_tensor_size": 1024,
        "pipeline_stage_1": {
          "layers": [1],
          "devices": [0,1,2,3,4,5,6,7]
        },
        "pipeline_stage_2": {
          "layers": [2],
          "devices": [8,9,10,11,12,13,14,15]
        }
      },
      "communication_pattern": {
        "tensor_parallel_communication": {
          "type": "all_reduce",
          "frequency": "per_layer",
          "bandwidth": "high"
        },
        "pipeline_parallel_communication": {
          "type": "point_to_point",
          "frequency": "per_microbatch",
          "bandwidth": "medium"
        }
      }
    }
  },
  "deployment_instructions": {
    "proposed_method": {
      "step1": "Initialize 16 GPU cluster with high-bandwidth interconnect",
      "step2": "Partition Q, K, V weight matrices into 16 blocks as specified",
      "step3": "Assign each (head_group, dimension_slice) partition to unique GPU",
      "step4": "Implement hierarchical all-gather operations for concatenation",
      "step5": "Use NCCL for efficient GPU communication",
      "step6": "Configure CUDA streams for overlapping computation and communication"
    },
    "baseline_tensor_parallel": {
      "step1": "Initialize 16 GPU cluster",
      "step2": "Configure 8-way tensor parallelism within each pipeline stage",
      "step3": "Configure 2-way pipeline parallelism across layers",
      "step4": "Implement all-reduce for tensor parallel communication",
      "step5": "Implement point-to-point communication for pipeline stages"
    }
  },
