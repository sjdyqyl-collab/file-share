{
  "models": {
    "ma_separation": {
      "name": "MA Separation MoE Model",
      "description": "4-layer MoE transformer with synchronized attention-expert execution",
      "parallel_strategy": {
        "type": "ma_separation",
        "attention_parallelism": {
          "type": "tensor_parallelism",
          "degree": 8,
          "replication_factor": 2,
          "sequence_parallelism": 2
        },
        "moe_parallelism": {
          "type": "expert_parallelism",
          "degree": 8,
          "experts_per_gpu": 2,
          "total_experts": 16
        },
        "synchronization": {
          "type": "barrier_synchronization",
          "time_prediction_model": "3_layer_neural_network",
          "sync_interval": 100,
          "load_balance_threshold": 0.05
        }
      },
      "modules": {
        "attention_modules": {
          "qkv_projection": {
            "type": "linear_layer",
            "input_dim": 4096,
            "output_dim": 12288,
            "parallel_strategy": "tensor_parallelism",
            "devices": [0, 1, 2, 3, 4, 5, 6, 7],
            "parameters": {
              "heads_per_gpu": 4,
              "head_dim": 128,
              "total_heads": 32
            }
          },
          "attention_computation": {
            "type": "multi_head_attention",
            "input_dims": [1024, 2048, 4096],
            "parallel_strategy": "tensor_parallelism",
            "devices": [0, 1, 2, 3, 4, 5, 6, 7],
            "parameters": {
              "attention_heads": 32,
              "heads_per_device": 4,
              "sequence_length": 2048,
              "hidden_dim": 4096
            }
          },
          "output_projection": {
            "type": "linear_layer",
            "input_dim": 4096,
            "output_dim": 4096,
            "parallel_strategy": "tensor_parallelism",
            "devices": [0, 1, 2, 3, 4, 5, 6, 7],
            "parameters": {
              "all_reduce_required": true,
              "hierarchical_reduction": true
            }
          }
        },
        "moe_modules": {
          "gate_network": {
            "type": "linear_layer",
            "input_dim": 4096,
            "output_dim": 16,
            "parallel_strategy": "data_parallelism",
            "devices": [8, 9, 10, 11, 12, 13, 14, 15],
            "parameters": {
              "top_k": 2,
              "load_balancing_loss": 0.01,
              "router_z_loss": 0.001
            }
          },
          "experts": {
            "type": "feed_forward_expert",
            "experts_per_gpu": 2,
            "expert_config": {
              "input_dim": 4096,
              "hidden_dim": 16384,
              "output_dim": 4096,
              "activation": "GELU"
            },
            "distribution": {
              "GPU_8": ["expert_0", "expert_1"],
              "GPU_9": ["expert_2", "expert_3"],
              "GPU_10": ["expert_4", "expert_5"],
              "GPU_11": ["expert_6", "expert_7"],
              "GPU_12": ["expert_8", "expert_9"],
              "GPU_13": ["expert_10", "expert_11"],
              "GPU_14": ["expert_12", "expert_13"],
              "GPU_15": ["expert_14", "expert_15"]
            },
            "devices": [8, 9, 10, 11, 12, 13, 14, 15]
          },
          "expert_aggregation": {
            "type": "weighted_sum",
            "devices": [8, 9, 10, 11, 12, 13, 14, 15],
            "parameters": {
              "all_to_all_required": true,
              "expert_capacity_factor": 1.0
            }
          }
        }
      },
      "device_mapping": {
        "attention_gpus": {
          "GPUs": [0, 1, 2, 3, 4, 5, 6, 7],
          "memory_per_gpu": "123.7GB",
          "utilization_target": "89.7%",
          "modules": [
            "qkv_projection",
            "attention_computation", 
            "output_projection"
          ]
        },
        "moe_gpus": {
          "GPUs": [8, 9, 10, 11, 12, 13, 14, 15],
          "memory_per_gpu": "123.7GB",
          "utilization_target": "89.7%",
          "modules": [
            "gate_network",
            "experts",
            "expert_aggregation"
          ]
        }
      },
      "communication": {
        "attention_all_reduce": {
          "type": "hierarchical_all_reduce",
          "intra_node": {
            "bandwidth": "600GB/s",
            "topology": "NVLink_mesh"
          },
          "inter_node": {
            "bandwidth": "200Gb/s",
            "topology": "fat_tree_infiniband"
          }
        },
        "moe_all_to_all": {
          "type": "all_to_all",
          "bandwidth": "200Gb/s",
          "topology": "fat_tree_infiniband"
        },
        "gradient_synchronization": {
          "type": "all_reduce",
          "compression": "8bit_quantization",
          "overlap_computation": true
        }
      },
      "performance_targets": {
        "TPOT": "1.82ms/token",
        "TPS": "13,289 tokens/s",
        "throughput": "212,624 tokens/s",
        "gpu_utilization": "89.7%",
        "memory_efficiency": "85.4%",
        "scaling_efficiency": "87%"
      }
    },
