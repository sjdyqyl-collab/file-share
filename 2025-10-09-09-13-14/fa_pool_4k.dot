	layer3_reshape_q [label="Reshape Q\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_reshape_k [label="Reshape K\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_reshape_v [label="Reshape V\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_attention [label="Multi-Head Attention\nInput: [batch_size, seq_len, 32, 128]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Distributed FlashAttention" fillcolor="#F8F9FA"]
	layer3_reshape_out [label="Reshape Output\nInput: [batch_size, seq_len, 32, 128]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_out_proj [label="Output Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Row-Parallel" fillcolor="#F8F9FA"]
	layer3_attn_input -> layer3_q_proj
	layer3_attn_input -> layer3_k_proj
	layer3_attn_input -> layer3_v_proj
	layer3_q_proj -> layer3_reshape_q
	layer3_k_proj -> layer3_reshape_k
	layer3_v_proj -> layer3_reshape_v
	layer3_reshape_q -> layer3_attention
	layer3_reshape_k -> layer3_attention
	layer3_reshape_v -> layer3_attention
	layer3_attention -> layer3_reshape_out
	layer3_reshape_out -> layer3_out_proj
	layer3_res1 [label="Residual Add 1\nInput: [batch_size, seq_len=4096, 4096], [batch_size, seq_len=4096, 4096]\nOutput: [batch_size, seq_len=4096, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#D4EDDA"]
	layer3_norm2 [label="RMSNorm 2\nInput: [batch_size, seq_len=4096, 4096]\nOutput: [batch_size, seq_len=4096, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_ffn_input [label="FFN Input\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	layer3_ffn_up [label="FFN Up Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 16384]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Column-Parallel" fillcolor="#F8F9FA"]
	layer3_gelu [label="GELU Activation\nInput: [batch_size, seq_len, 16384]\nOutput: [batch_size, seq_len, 16384]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	layer3_ffn_down [label="FFN Down Projection\nInput: [batch_size, seq_len, 16384]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Row-Parallel" fillcolor="#F8F9FA"]
	layer3_ffn_input -> layer3_ffn_up
	layer3_ffn_up -> layer3_gelu
	layer3_gelu -> layer3_ffn_down
	layer3_res2 [label="Residual Add 2\nInput: [batch_size, seq_len=4096, 4096], [batch_size, seq_len=4096, 4096]\nOutput: [batch_size, seq_len=4096, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#D4EDDA"]
	layer3_output [label="Layer 3 Output\nInput: [batch_size, seq_len=4096, 4096]\nOutput: [batch_size, seq_len=4096, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	layer3_input -> layer3_norm1
	layer3_norm1 -> layer3_attn_input
	layer3_attn_output -> layer3_res1
	layer3_input -> layer3_res1
	layer3_res1 -> layer3_norm2
	layer3_norm2 -> layer3_ffn_input
	layer3_ffn_output -> layer3_res2
	layer3_res1 -> layer3_res2
	layer3_res2 -> layer3_output
	output_layer [label="Output Projection\nInput: [batch_size, seq_len=4096, 4096]\nOutput: [batch_size, seq_len=4096, 50256]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3', 'gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	output [label="Model Output\nInput: [batch_size, seq_len=4096, 50256]\nOutput: [batch_size, seq_len=4096, 50256]" fillcolor="#D1E7DD" shape=ellipse]
	input -> embedding
	embedding -> pos_encoding
	pos_encoding -> layer0_input
	layer0_output -> layer1_input
	layer1_output -> layer2_input
	layer2_output -> layer3_input
	layer3_output -> output_layer
	output_layer -> output
}
