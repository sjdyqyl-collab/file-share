	stage0_layer0_k_proj -> stage0_layer0_reshape_k
	stage0_layer0_v_proj -> stage0_layer0_reshape_v
	stage0_layer0_reshape_q -> stage0_layer0_attention
	stage0_layer0_reshape_k -> stage0_layer0_attention
	stage0_layer0_reshape_v -> stage0_layer0_attention
	stage0_layer0_attention -> stage0_layer0_reshape_out
	stage0_layer0_reshape_out -> stage0_layer0_out_proj
	stage0_layer0_res1 [label="Residual Add 1\nInput: [batch_size, seq_len, 4096], [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#D4EDDA"]
	stage0_layer0_norm2 [label="RMSNorm 2\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_ffn_input [label="FFN Input\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	stage0_layer0_ffn_up [label="FFN Up Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 16384]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Column-Parallel" fillcolor="#F8F9FA"]
