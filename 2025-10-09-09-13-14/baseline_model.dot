	stage1_layer3_attention -> stage1_layer3_reshape_out
	stage1_layer3_reshape_out -> stage1_layer3_out_proj
	stage1_layer3_res1 [label="Residual Add 1\nInput: [batch_size, seq_len, 4096], [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#D4EDDA"]
	stage1_layer3_norm2 [label="RMSNorm 2\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	stage1_layer3_ffn_input [label="FFN Input\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	stage1_layer3_ffn_up [label="FFN Up Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 16384]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Column-Parallel" fillcolor="#F8F9FA"]
	stage1_layer3_gelu [label="GELU Activation\nInput: [batch_size, seq_len, 16384]\nOutput: [batch_size, seq_len, 16384]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#F8F9FA"]
	stage1_layer3_ffn_down [label="FFN Down Projection\nInput: [batch_size, seq_len, 16384]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']\nType: Row-Parallel" fillcolor="#F8F9FA"]
	stage1_layer3_ffn_input -> stage1_layer3_ffn_up
	stage1_layer3_ffn_up -> stage1_layer3_gelu
	stage1_layer3_gelu -> stage1_layer3_ffn_down
	stage1_layer3_res2 [label="Residual Add 2\nInput: [batch_size, seq_len, 4096], [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_4', 'gpu_5', 'gpu_6', 'gpu_7']" fillcolor="#D4EDDA"]
	stage1_layer3_output [label="Layer 3 Output\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	stage1_layer3_input -> stage1_layer3_norm1
	stage1_layer3_norm1 -> stage1_layer3_attn_input
	stage1_layer3_attn_output -> stage1_layer3_res1
	stage1_layer3_input -> stage1_layer3_res1
	stage1_layer3_res1 -> stage1_layer3_norm2
	stage1_layer3_norm2 -> stage1_layer3_ffn_input
	stage1_layer3_ffn_output -> stage1_layer3_res2
	stage1_layer3_res1 -> stage1_layer3_res2
	stage1_layer3_res2 -> stage1_layer3_output
	stage1_input -> stage1_layer2_input
	stage1_layer2_output -> stage1_layer3_input
	output_layer [label="Output Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 50256]\nGPUs: [4-7]" fillcolor="#F8F9FA"]
	output [label="Model Output\nInput: [batch_size, seq_len, 50256]\nOutput: [batch_size, seq_len, 50256]" fillcolor="#D1E7DD" shape=ellipse]
	input -> embedding
	embedding -> pos_encoding
	pos_encoding -> stage0_layer0_input
	stage0_layer1_output -> stage1_layer2_input
	stage1_layer3_output -> output_layer
	output_layer -> output
}
