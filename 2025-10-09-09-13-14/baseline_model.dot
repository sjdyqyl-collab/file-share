// 4-layer Dense Model - Baseline Configuration
digraph baseline_model {
	graph [nodesep=0.5 rankdir=TB ranksep=1.0 splines=ortho]
	node [fillcolor="#F8F9FA" shape=rectangle style=filled]
	input [label="Model Input\nInput: [batch_size, seq_len]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#E8F4FD" shape=ellipse]
	embedding [label="Embedding Layer\nInput: [batch_size, seq_len]\nOutput: [batch_size, seq_len, 4096]\nGPUs: [0-7]" fillcolor="#F8F9FA"]
	pos_encoding [label="RoPE Positional Encoding\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: [0-7]" fillcolor="#F8F9FA"]
	stage0_input [label="Pipeline Stage 0\nLayers: 0-1\nGPUs: [0-3]\nInput Processing" fillcolor="#FFE6CC" shape=parallelogram]
	stage0_layer0_input [label="Layer 0 Input\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	stage0_layer0_norm1 [label="RMSNorm 1\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_attn_input [label="Attention Input\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]" fillcolor="#FFE6CC" shape=parallelogram]
	stage0_layer0_q_proj [label="Q Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Column-Parallel" fillcolor="#F8F9FA"]
	stage0_layer0_k_proj [label="K Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Column-Parallel" fillcolor="#F8F9FA"]
	stage0_layer0_v_proj [label="V Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Column-Parallel" fillcolor="#F8F9FA"]
	stage0_layer0_reshape_q [label="Reshape Q\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_reshape_k [label="Reshape K\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_reshape_v [label="Reshape V\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_attention [label="Multi-Head Attention\nInput: [batch_size, seq_len, 32, 128]\nOutput: [batch_size, seq_len, 32, 128]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Distributed FlashAttention" fillcolor="#F8F9FA"]
	stage0_layer0_reshape_out [label="Reshape Output\nInput: [batch_size, seq_len, 32, 128]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']" fillcolor="#F8F9FA"]
	stage0_layer0_out_proj [label="Output Projection\nInput: [batch_size, seq_len, 4096]\nOutput: [batch_size, seq_len, 4096]\nGPUs: ['gpu_0', 'gpu_1', 'gpu_2', 'gpu_3']\nType: Row-Parallel" fillcolor="#F8F9FA"]
