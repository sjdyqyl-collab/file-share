        "result_aggregation": {
          "type": "all_gather",
          "method": "hierarchical_tree_reduction",
          "steps": "log2(num_pool_gpus)",
          "bandwidth": "600GB/s_nvlink"
        },
        "synchronization": {
          "type": "cuda_events",
          "overlap_with_ffn": true
        }
      }
    }
