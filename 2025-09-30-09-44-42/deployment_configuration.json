    }
  },
  "common_parameters": {
    "model": {
      "layers": 4,
      "hidden_dim": 4096,
      "num_heads": 32,
      "num_experts": 16,
      "expert_dim": 16384,
      "seq_len": 2048,
      "vocab_size": 50265
    },
    "training": {
      "batch_size": 1024,
      "learning_rate": 1e-4,
      "optimizer": "AdamW",
      "weight_decay": 0.1,
      "training_steps": 50000,
      "warmup_steps": 5000
