{
  "deployment_configurations": {
    "ma_separation": {
      "name": "MA Separation",
      "description": "Novel parallel strategy synchronizing attention and MoE execution",
      "total_gpus": 16,
      "parallel_strategy": {
        "type": "hybrid",
        "attention_parallelism": {
          "type": "tensor_parallelism",
          "degree": 8,
          "replication_factor": 2,
          "strategy": "head_parallelism"
        },
        "moe_parallelism": {
          "type": "expert_parallelism",
          "degree": 8,
          "experts_per_gpu": 2
        }
      },
      "gpu_mapping": {
        "attention_gpus": [0, 1, 2, 3, 4, 5, 6, 7],
        "moe_gpus": [8, 9, 10, 11, 12, 13, 14, 15],
        "node_mapping": {
          "node_0": {"attention": [0, 1], "moe": [8, 9]},
          "node_1": {"attention": [2, 3], "moe": [10, 11]},
          "node_2": {"attention": [4, 5], "moe": [12, 13]},
          "node_3": {"attention": [6, 7], "moe": [14, 15]}
        }
      },
      "modules": {
        "attention_module": {
          "type": "multi_head_attention",
          "parameters": {
            "num_heads": 32,
            "head_dim": 128,
            "hidden_dim": 4096,
            "seq_len": 2048,
            "batch_size": 1024
          },
          "parallel_config": {
            "heads_per_gpu": 4,
            "sequence_parallel": true,
            "sequence_split": 2
          },
          "device_mapping": {
            "gpu_0": {"heads": [0, 1, 2, 3]},
            "gpu_1": {"heads": [4, 5, 6, 7]},
            "gpu_2": {"heads": [8, 9, 10, 11]},
            "gpu_3": {"heads": [12, 13, 14, 15]},
            "gpu_4": {"heads": [16, 17, 18, 19]},
            "gpu_5": {"heads": [20, 21, 22, 23]},
            "gpu_6": {"heads": [24, 25, 26, 27]},
            "gpu_7": {"heads": [28, 29, 30, 31]}
          }
        },
        "moe_module": {
          "type": "mixture_of_experts",
          "parameters": {
            "num_experts": 16,
            "expert_dim": 16384,
            "hidden_dim": 4096,
            "top_k": 2,
            "capacity_factor": 1.0
          },
          "parallel_config": {
            "experts_per_gpu": 2,
            "expert_distribution": "uniform"
          },
          "device_mapping": {
            "gpu_8": {"experts": [0, 1]},
            "gpu_9": {"experts": [2, 3]},
            "gpu_10": {"experts": [4, 5]},
            "gpu_11": {"experts": [6, 7]},
            "gpu_12": {"experts": [8, 9]},
            "gpu_13": {"experts": [10, 11]},
            "gpu_14": {"experts": [12, 13]},
            "gpu_15": {"experts": [14, 15]}
          }
        }
      },
      "communication": {
        "attention_all_reduce": {
          "type": "hierarchical_all_reduce",
          "intra_node": "nvlink",
          "inter_node": "infiniband",
          "buffer_size": "64MB"
        },
        "moe_all_to_all": {
          "type": "all_to_all",
          "buffer_size": "32MB"
        },
        "gradient_compression": {
          "type": "8bit_quantization",
          "compression_ratio": 4
        }
      },
      "synchronization": {
        "time_prediction_model": {
          "type": "neural_network",
          "layers": [64, 32, 16],
          "input_features": ["seq_len", "hidden_dim", "num_experts", "gpu_utilization"]
        },
        "sync_interval": 100,
        "load_balance_threshold": 0.05,
        "barrier_type": "cuda_events"
      }
    },
    "baseline_tensor_parallelism": {
      "name": "Tensor Parallelism (TP=8)",
      "description": "Traditional 8-way tensor parallelism baseline",
      "total_gpus": 16,
      "parallel_strategy": {
        "type": "tensor_parallelism",
        "degree": 8,
        "strategy": "model_parallelism"
      },
      "gpu_mapping": {
        "model_gpus": [0, 1, 2, 3, 4, 5, 6, 7],
        "unused_gpus": [8, 9, 10, 11, 12, 13, 14, 15]
      },
      "modules": {
        "attention_module": {
          "type": "multi_head_attention",
          "parameters": {
            "num_heads": 32,
            "head_dim": 128,
            "hidden_dim": 4096,
            "seq_len": 2048,
            "batch_size": 1024
          },
          "parallel_config": {
            "tensor_split": 8,
            "dimensions": ["hidden", "head"]
          },
          "device_mapping": {
            "gpu_0": {"tensor_slice": 0},
            "gpu_1": {"tensor_slice": 1},
            "gpu_2": {"tensor_slice": 2},
            "gpu_3": {"tensor_slice": 3},
            "gpu_4": {"tensor_slice": 4},
            "gpu_5": {"tensor_slice": 5},
            "gpu_6": {"tensor_slice": 6},
            "gpu_7": {"tensor_slice": 7}
          }
        },
        "moe_module": {
          "type": "mixture_of_experts",
          "parameters": {
            "num_experts": 16,
            "expert_dim": 16384,
            "hidden_dim": 4096,
            "top_k": 2,
            "capacity_factor": 1.0
          },
          "parallel_config": {
            "tensor_split": 8,
            "expert_replication": true
          },
          "device_mapping": {
            "gpu_0": {"tensor_slice": 0},
            "gpu_1": {"tensor_slice": 1},
            "gpu_2": {"tensor_slice": 2},
            "gpu_3": {"tensor_slice": 3},
            "gpu_4": {"tensor_slice": 4},
            "gpu_5": {"tensor_slice": 5},
            "gpu_6": {"tensor_slice": 6},
            "gpu_7": {"tensor_slice": 7}
          }
        }
      },
      "communication": {
        "all_reduce": {
          "type": "nccl_all_reduce",
          "algorithm": "ring",
          "buffer_size": "128MB"
        }
      }
    },
    "baseline_pipeline_parallelism": {
      "name": "Pipeline Parallelism (PP=2)",
      "description": "Traditional 2-stage pipeline parallelism baseline",
      "total_gpus": 16,
      "parallel_strategy": {
        "type": "pipeline_parallelism",
        "stages": 2,
        "micro_batches": 4
      },
      "gpu_mapping": {
        "stage_0_gpus": [0, 1, 2, 3, 4, 5, 6, 7],
        "stage_1_gpus": [8, 9, 10, 11, 12, 13, 14, 15]
      },
      "modules": {
        "stage_0": {
          "layers": [0, 1],
          "type": "transformer_layers",
          "parameters": {
            "num_layers": 2,
            "hidden_dim": 4096,
            "num_heads": 32,
            "num_experts": 16
          },
          "device_mapping": {
            "gpu_0": {"layer": 0, "replica": 0},
            "gpu_1": {"layer": 0, "replica": 1},
            "gpu_2": {"layer": 0, "replica": 2},
            "gpu_3": {"layer": 0, "replica": 3},
            "gpu_4": {"layer": 0, "replica": 4},
            "gpu_5": {"layer": 0, "replica": 5},
            "gpu_6": {"layer": 0, "replica": 6},
            "gpu_7": {"layer": 0, "replica": 7},
            "gpu_8": {"layer": 1, "replica": 0},
            "gpu_9": {"layer": 1, "replica": 1},
            "gpu_10": {"layer": 1, "replica": 2},
            "gpu_11": {"layer": 1, "replica": 3},
            "gpu_12": {"layer": 1, "replica": 4},
            "gpu_13": {"layer": 1, "replica": 5},
            "gpu_14": {"layer": 1, "replica": 6},
            "gpu_15": {"layer": 1, "replica": 7}
          }
        }
      },
      "communication": {
        "pipeline_send_recv": {
          "type": "point_to_point",
          "buffer_size": "256MB"
        }
      }
    },
    "baseline_hybrid": {
      "name": "Hybrid TP+PP (TP=8, PP=2)",
      "description": "Combined tensor and pipeline parallelism baseline",
      "total_gpus": 16,
      "parallel_strategy": {
        "type": "hybrid",
        "tensor_parallelism": {
          "degree": 8,
          "within_stages": true
        },
        "pipeline_parallelism": {
          "stages": 2,
          "micro_batches": 4
        }
      },
      "gpu_mapping": {
        "stage_0": [0, 1, 2, 3, 4, 5, 6, 7],
        "stage_1": [8, 9, 10, 11, 12, 13, 14, 15]
      },
      "modules": {
        "stage_0": {
          "layers": [0, 1],
          "type": "transformer_layers",
          "parameters": {
            "num_layers": 2,
            "hidden_dim": 4096,
            "num_heads": 32,
            "num_experts": 16
          },
          "tensor_parallelism": {
            "degree": 8,
            "device_mapping": {
              "gpu_0": {"tensor_slice": 0, "layer": 0},
              "gpu_1": {"tensor_slice": 1, "layer": 0},
              "gpu_2": {"tensor_slice": 2, "layer": 0},
              "gpu_3": {"tensor_slice": 3, "layer": 0},
              "gpu_4": {"tensor_slice": 4, "layer": 0},
              "gpu_5": {"tensor_slice": 5, "layer": 0},
              "gpu_6": {"tensor_slice": 6, "layer": 0},
              "gpu_7": {"tensor_slice": 7, "layer": 0}
            }
          }
        },
        "stage_1": {
          "layers": [2, 3],
          "type": "transformer_layers",
          "parameters": {
            "num_layers": 2,
            "hidden_dim": 4096,
            "num_heads": 32,
            "num_experts": 16
          },
          "tensor_parallelism": {
            "degree": 8,
            "device_mapping": {
              "gpu_8": {"tensor_slice": 0, "layer": 2},
              "gpu_9": {"tensor_slice": 1, "layer": 2},
              "gpu_10": {"tensor_slice": 2, "layer": 2},
              "gpu_11": {"tensor_slice": 3, "layer": 2},
              "gpu_12": {"tensor_slice": 4, "layer": 2},
              "gpu_13": {"tensor_slice": 5, "layer": 2},
              "gpu_14": {"tensor_slice": 6, "layer": 2},
              "gpu_15": {"tensor_slice": 7, "layer": 2}
            }
          }
        }
      },
      "communication": {
        "tensor_all_reduce": {
          "type": "nccl_all_reduce",
          "within_stages": true
        },
        "pipeline_send_recv": {
          "type": "point_to_point",
