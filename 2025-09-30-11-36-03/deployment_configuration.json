    },
    "gpu_4": {
      "model": "NVIDIA_A100_80GB",
      "role": "base_layer",
      "memory": "65GB_allocated",
      "components": ["layer_2_ffn", "layer_3_ffn"]
    },
    "gpu_5": {
      "model": "NVIDIA_A100_80GB",
      "role": "base_layer",
      "memory": "65GB_allocated",
      "components": ["layer_2_ffn", "layer_3_ffn"]
    },
    "gpu_6": {
      "model": "NVIDIA_A100_80GB",
      "role": "base_layer",
      "memory": "65GB_allocated",
      "components": ["layer_2_attention_weights", "layer_3_attention_weights"]
    },
    "gpu_7": {
      "model": "NVIDIA_A100_80GB",
      "role": "base_layer",
      "memory": "65GB_allocated",
      "components": ["layer_2_attention_weights", "layer_3_attention_weights", "output_projection", "resource_manager"]
    },
    "gpu_16": {
      "model": "NVIDIA_A100_80GB",
      "role": "attention_pool",
      "memory": "45GB_allocated",
      "activation_condition": "sequence_length > 4096",
      "block_computation": "attention_block_0"
    },
    "gpu_17": {
      "model": "NVIDIA_A100_80GB",
