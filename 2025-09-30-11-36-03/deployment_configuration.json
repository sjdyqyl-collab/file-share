      "activation_condition": "sequence_length > 32768",
      "block_computation": "attention_block_7"
    }
  },
  "communication_topology": {
    "nvlink_groups": {
      "base_layer_mesh": [0, 1, 2, 3, 4, 5, 6, 7],
      "attention_pool_mesh": [16, 17, 18, 19, 20, 21, 22, 23],
      "cross_group": "infiniband_between_base_and_pool"
