  "memory_calculation": {
    "formula": "size(l_j) = weight_size(l_j) + activation_size(l_j) + buffer_size(l_j)",
    "weight_size": "num_parameters * 2_bytes (FP16)",
    "activation_size": "output_feature_map_dimensions * batch_size",
    "buffer_size": "operator_workspace_from_profiling"
  },
  "deployment_constraints": {
    "cache_capacity": "SRAM_L2_cache_per_device",
    "max_partition_size": "cache_capacity",
    "contiguous_layers": true,
