{
  "deployment_models": {
    "baseline": {
      "name": "Tensor Parallelism + Pipeline Parallelism",
      "description": "Traditional parallelization strategy using tensor and pipeline parallelism without sequence parallelism or ring attention",
      "configuration": {
        "tensor_parallelism": {
          "degree": 8,
          "implementation": "NCCL all-reduce operations across tensor parallel group",
          "parameters": {
            "attention_heads": 16,
            "head_dimension": 512,
            "split_dimension": "hidden_size",
            "communication_pattern": "all-reduce"
          }
        },
        "pipeline_parallelism": {
          "degree": 2,
          "implementation": "GPipe-style pipeline with micro-batching",
          "parameters": {
            "layers_per_stage": 2,
            "micro_batch_size": 64,
            "pipeline_schedule": "1F1B"
          }
        },
        "memory_layout": {
          "activation_memory": "O(L * d_model) per device",
          "sequence_storage": "Full sequence on each device"
        }
      }
    },
    "proposed": {
      "name": "Ring Attention + Sequence Parallelism",
      "description": "Novel combination of ring attention with sequence parallelism for efficient MHA computation",
      "configuration": {
        "sequence_parallelism": {
          "degree": 16,
          "implementation": "Split sequence dimension across devices",
          "parameters": {
            "sequence_split": "L/P per device",
            "local_sequence_length": "L/16",
            "memory_reduction": "16x activation memory reduction"
          }
        },
        "ring_attention": {
          "topology": "logical ring",
          "stages": 16,
          "implementation": "NCCL send/recv primitives with point-to-point communication",
          "parameters": {
            "communication_pattern": "sequential peer-to-peer",
            "bandwidth_per_stage": "O(L/P * d_model)",
            "total_stages": 16,
            "overlap": "computation-communication overlap enabled"
          },
          "algorithm": {
            "step_0": "Compute local Q_p, K_p, V_p from X_p",
            "step_1": "Initialize KV_block = (K_p, V_p)",
            "step_2": "For t in 0..15: compute partial attention with current KV_block",
            "step_3": "Send KV_block to next device, receive from previous",
            "step_4": "Accumulate partial results over 16 stages"
          }
        },
        "memory_layout": {
          "activation_memory": "O(L/P * d_model) per device",
          "sequence_storage": "1/16th of sequence per device"
        },
        "precision": {
          "compute_precision": "FP16",
          "communication_precision": "FP16",
          "mixed_precision": true
        }
      }
    }
  },
