          "parameters": {
            "num_stages": 2,
            "micro_batch_size": 512,
            "schedule": "1f1b"
          }
        }
      },
      "model_modules": {
        "dense_model": {
          "total_layers": 16,
          "layer_distribution": {
            "stage_0": {
              "device_range": [0, 7],
