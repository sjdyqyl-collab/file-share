          },
          "partitions": {
            "partition_0": {
              "device_id": 0,
              "layers": [0, 1, 2, 3],
              "memory_footprint": "39.8MB",
              "parameters": {
                "layer_range": [0, 3],
                "cache_allocation": "full_on_chip",
                "weight_memory": "32MB",
                "activation_memory": "6.8MB",
