  "communication_parameters": {
    "baseline": {
      "all_reduce_for_tensor_parallel": true,
      "pipeline_parallel_communication": "point_to_point",
      "communication_backend": "nccl"
    },
    "ra_sp": {
      "ring_communication": {
        "send_recv_primitives": "nccl_send_recv",
        "stages": 16,
        "kv_block_size": "(1024 * 512 * 2) bytes",  # sequence_slice * head_dim * (K+V)
        "overlap_computation": true,
        "asynchronous_communication": true
      },
      "communication_backend": "nccl"
    }
  },
  "memory_optimization": {
    "baseline": {
      "activation_memory_per_device": "L * d_model / (TP * PP)",
      "sequence_parallel_memory_reduction": 1.0
    },
    "ra_sp": {
      "activation_memory_per_device": "(L/P) * d_model",
      "sequence_parallel_memory_reduction": 16.0,
      "ring_attention_memory_overhead": "P * (L/P) * d_h * 2"  # KV blocks
    }
  }
}