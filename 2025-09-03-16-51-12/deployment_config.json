      "heads": 16,
      "head_dimension": 512,
      "hidden_size": 8192,
      "mlp_hidden_size": 32768,
      "precision": "fp16",
      "batch_size": 1024,
      "sequence_length": 16384
    },
    "ra_sp": {
      "name": "Dense Transformer RA+SP",
      "layers": 4,
      "heads": 16,
      "head_dimension": 512,
