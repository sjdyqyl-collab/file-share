        "2. Apply_greedy_partitioning_algorithm",
        "3. Assign_partitions_to_gpus",
        "4. Load_weights_to_SRAM_L2_cache",
        "5. Pre_allocate_activations_buffers",
        "6. Execute_layers_sequentially_per_gpu",
