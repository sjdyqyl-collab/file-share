digraph baseline_tp8_pp2 {
    rankdir=TB;
    node [shape=rectangle];
    
    // Input node
    input [label="Input\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: all GPUs", shape=parallelogram];
    
    // Layer 0 - Stage 0 (GPUs 0-7)
    subgraph cluster_layer0_stage0 {
        label="Layer 0 - Stage 0 (GPUs 0-7)";
        style=dashed;
        
        // MHA for layer 0 stage 0
        mha_0_0 [label="Multi-Head Attention\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=rectangle];
        mha_0_0_norm [label="Layer Norm\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=rectangle];
        mha_0_0_add [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=ellipse];
        
        // Expert selection and routing
        gate_0_0 [label="Gating Network\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, experts=16]\nGPU: 0-7", shape=parallelogram];
        
        // Expert 0-7 on GPUs 0-7
        expert_0_0 [label="Expert 0 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 0", shape=rectangle];
        expert_0_1 [label="Expert 1 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 1", shape=rectangle];
        expert_0_2 [label="Expert 2 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 2", shape=rectangle];
        expert_0_3 [label="Expert 3 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 3", shape=rectangle];
        expert_0_4 [label="Expert 4 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 4", shape=rectangle];
        expert_0_5 [label="Expert 5 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 5", shape=rectangle];
        expert_0_6 [label="Expert 6 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 6", shape=rectangle];
        expert_0_7 [label="Expert 7 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 7", shape=rectangle];
        
        // Replicated experts 8-15 on GPUs 0-7
        expert_0_8 [label="Expert 8 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 0", shape=rectangle];
        expert_0_9 [label="Expert 9 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 1", shape=rectangle];
        expert_0_10 [label="Expert 10 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 2", shape=rectangle];
        expert_0_11 [label="Expert 11 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 3", shape=rectangle];
        expert_0_12 [label="Expert 12 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 4", shape=rectangle];
        expert_0_13 [label="Expert 13 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 5", shape=rectangle];
        expert_0_14 [label="Expert 14 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 6", shape=rectangle];
        expert_0_15 [label="Expert 15 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 7", shape=rectangle];
        
        // Aggregation
        agg_0_0 [label="Expert Aggregation\nInput: [tokens, dim=8192] from 16 experts\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=parallelogram];
        ffn_0_0 [label="FFN\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=rectangle];
        ffn_0_0_norm [label="Layer Norm\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=rectangle];
        ffn_0_0_add [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7", shape=ellipse];
    }
    
    // Pipeline communication to stage 1
    pipe_0_1 [label="Pipeline Transfer\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 0-7 → 8-15", shape=ellipse];
    
    // Layer 0 - Stage 1 (GPUs 8-15)
    subgraph cluster_layer0_stage1 {
        label="Layer 0 - Stage 1 (GPUs 8-15)";
        style=dashed;
        
        // Same structure as stage 0 but on GPUs 8-15
        mha_0_1 [label="Multi-Head Attention\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=rectangle];
        mha_0_1_norm [label="Layer Norm\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=rectangle];
        mha_0_1_add [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=ellipse];
        
        gate_0_1 [label="Gating Network\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, experts=16]\nGPU: 8-15", shape=parallelogram];
        
        // Expert 0-7 on GPUs 8-15
        expert_0_0_s1 [label="Expert 0 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 8", shape=rectangle];
        expert_0_1_s1 [label="Expert 1 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 9", shape=rectangle];
        expert_0_2_s1 [label="Expert 2 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 10", shape=rectangle];
        expert_0_3_s1 [label="Expert 3 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 11", shape=rectangle];
        expert_0_4_s1 [label="Expert 4 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 12", shape=rectangle];
        expert_0_5_s1 [label="Expert 5 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 13", shape=rectangle];
        expert_0_6_s1 [label="Expert 6 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 14", shape=rectangle];
        expert_0_7_s1 [label="Expert 7 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 15", shape=rectangle];
        
        // Replicated experts 8-15 on GPUs 8-15
        expert_0_8_s1 [label="Expert 8 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 8", shape=rectangle];
        expert_0_9_s1 [label="Expert 9 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 9", shape=rectangle];
        expert_0_10_s1 [label="Expert 10 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 10", shape=rectangle];
        expert_0_11_s1 [label="Expert 11 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 11", shape=rectangle];
        expert_0_12_s1 [label="Expert 12 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 12", shape=rectangle];
        expert_0_13_s1 [label="Expert 13 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 13", shape=rectangle];
        expert_0_14_s1 [label="Expert 14 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 14", shape=rectangle];
        expert_0_15_s1 [label="Expert 15 MLP\nInput: [tokens, dim=8192]\nOutput: [tokens, dim=8192]\nGPU: 15", shape=rectangle];
        
        agg_0_1 [label="Expert Aggregation\nInput: [tokens, dim=8192] from 16 experts\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=parallelogram];
        ffn_0_1 [label="FFN\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=rectangle];
        ffn_0_1_norm [label="Layer Norm\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=rectangle];
        ffn_0_1_add [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: 8-15", shape=ellipse];
    }
    
    // Connections for Layer 0
    input -> mha_0_0;
    mha_0_0 -> mha_0_0_norm;
    mha_0_0_norm -> mha_0_0_add;
    input -> mha_0_0_add [style=dashed];
    mha_0_0_add -> gate_0_0;
    
    // Expert routing (simplified - actual routing would be more complex)
    gate_0_0 -> expert_0_0 [style=dashed];
    gate_0_0 -> expert_0_1 [style=dashed];
    gate_0_0 -> expert_0_2 [style=dashed];
    gate_0_0 -> expert_0_3 [style=dashed];
    gate_0_0 -> expert_0_4 [style=dashed];
    gate_0_0 -> expert_0_5 [style=dashed];
    gate_0_0 -> expert_0_6 [style=dashed];
    gate_0_0 -> expert_0_7 [style=dashed];
    gate_0_0 -> expert_0_8 [style=dashed];
    gate_0_0 -> expert_0_9 [style=dashed];
    gate_0_0 -> expert_0_10 [style=dashed];
    gate_0_0 -> expert_0_11 [style=dashed];
    gate_0_0 -> expert_0_12 [style=dashed];
    gate_0_0 -> expert_0_13 [style=dashed];
    gate_0_0 -> expert_0_14 [style=dashed];
    gate_0_0 -> expert_0_15 [style=dashed];
    
    // Expert outputs to aggregation
    expert_0_0 -> agg_0_0;
    expert_0_1 -> agg_0_0;
    expert_0_2 -> agg_0_0;
    expert_0_3 -> agg_0_0;
    expert_0_4 -> agg_0_0;
    expert_0_5 -> agg_0_0;
    expert_0_6 -> agg_0_0;
    expert_0_7 -> agg_0_0;
    expert_0_8 -> agg_0_0;
    expert_0_9 -> agg_0_0;
    expert_0_10 -> agg_0_0;
    expert_0_11 -> agg_0_0;
    expert_0_12 -> agg_0_0;
    expert_0_13 -> agg_0_0;
    expert_0_14 -> agg_0_0;
    expert_0_15 -> agg_0_0;
    
    agg_0_0 -> ffn_0_0;
    ffn_0_0 -> ffn_0_0_norm;
    ffn_0_0_norm -> ffn_0_0_add;
    mha_0_0_add -> ffn_0_0_add [style=dashed];
    ffn_0_0_add -> pipe_0_1;
    
    // Pipeline stage 1 connections
    pipe_0_1 -> mha_0_1;
    mha_0_1 -> mha_0_1_norm;
    mha_0_1_norm -> mha_0_1_add;
    pipe_0_1 -> mha_0_1_add [style=dashed];
    mha_0_1_add -> gate_0_1;
    
    gate_0_1 -> expert_0_0_s1 [style=dashed];
    gate_0_1 -> expert_0_1_s1 [style=dashed];
    gate_0_1 -> expert_0_2_s1 [style=dashed];
    gate_0_1 -> expert_0_3_s1 [style=dashed];
    gate_0_1 -> expert_0_4_s1 [style=dashed];
    gate_0_1 -> expert_0_5_s1 [style=dashed];
    gate_0_1 -> expert_0_6_s1 [style=dashed];
    gate_0_1 -> expert_0_7_s1 [style=dashed];
    gate_0_1 -> expert_0_8_s1 [style=dashed];
    gate_0_1 -> expert_0_9_s1 [style=dashed];
    gate_0_1 -> expert_0_10_s1 [style=dashed];
    gate_0_1 -> expert_0_11_s1 [style=dashed];
    gate_0_1 -> expert_0_12_s1 [style=dashed];
    gate_0_1 -> expert_0_13_s1 [style=dashed];
    gate_0_1 -> expert_0_14_s1 [style=dashed];
    gate_0_1 -> expert_0_15_s1 [style=dashed];
    
    expert_0_0_s1 -> agg_0_1;
    expert_0_1_s1 -> agg_0_1;
    expert_0_2_s1 -> agg_0_1;
    expert_0_3_s1 -> agg_0_1;
    expert_0_4_s1 -> agg_0_1;
    expert_0_5_s1 -> agg_0_1;
    expert_0_6_s1 -> agg_0_1;
    expert_0_7_s1 -> agg_0_1;
    expert_0_8_s1 -> agg_0_1;
    expert_0_9_s1 -> agg_0_1;
    expert_0_10_s1 -> agg_0_1;
    expert_0_11_s1 -> agg_0_1;
    expert_0_12_s1 -> agg_0_1;
    expert_0_13_s1 -> agg_0_1;
    expert_0_14_s1 -> agg_0_1;
    expert_0_15_s1 -> agg_0_1;
    
    agg_0_1 -> ffn_0_1;
    ffn_0_1 -> ffn_0_1_norm;
    ffn_0_1_norm -> ffn_0_1_add;
    mha_0_1_add -> ffn_0_1_add [style=dashed];
    
    // Continue with layers 1-3 (simplified structure)
    // Layer 1 would follow similar pattern
    // Layer 2 would follow similar pattern  
    // Layer 3 would follow similar pattern
    
    // Output
    output [label="Output\nInput: [batch_size=1024, seq_len=10000, dim=8192]\nOutput: [batch_size=1024, seq_len=10000, dim=8192]\nGPU: all GPUs", shape=parallelogram];
    ffn_0_1_add -> output;
}