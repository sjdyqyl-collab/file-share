digraph baseline_tp8_pp2_complete {
    rankdir=TB;
    node [shape=rectangle, style=filled];
    
    // Input handling
    input [label="Input\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: all GPUs", shape=ellipse, fillcolor=lightblue];
    
    // Layer 0 - Stage 0 (GPUs 0-7)
    subgraph cluster_layer0_stage0 {
        label="Layer 0 - Stage 0 (GPUs 0-7)";
        style=dashed;
        
        // Layer Norm - distributed across all GPUs in stage 0
        ln0_s0 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightyellow];
        
        // MHA - distributed across all GPUs in stage 0
        mha_q0_s0 [label="Q Linear\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nGPU: 0-7", fillcolor=lightgreen];
        mha_k0_s0 [label="K Linear\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nGPU: 0-7", fillcolor=lightgreen];
        mha_v0_s0 [label="V Linear\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nGPU: 0-7", fillcolor=lightgreen];
        
        // Attention computation
        attn0_s0 [label="Attention\nInput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nOutput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nGPU: 0-7", fillcolor=lightcoral];
        
        // Output projection
        mha_out0_s0 [label="MHA Output Linear\nInput: [batch_size=1024, seq_len=10000, heads=16, d_k=512]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightgreen];
        
        // Residual connection
        residual0_s0 [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightgray];
        
        // Layer norm for FFN
        ln1_0_s0 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightyellow];
        
        // Experts - each GPU has 8 experts
        subgraph cluster_experts0_s0 {
            label="Experts Layer 0 - Stage 0";
            style=dotted;
            
            // Expert 0-7 on GPU 0
            expert0_gpu0 [label="Expert 0-7\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0", fillcolor=lightpink];
            
            // Expert 8-15 on GPU 1
            expert8_gpu1 [label="Expert 8-15\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 1", fillcolor=lightpink];
            
            // Expert 0-7 on GPU 2
            expert0_gpu2 [label="Expert 0-7\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 2", fillcolor=lightpink];
            
            // Expert 8-15 on GPU 3
            expert8_gpu3 [label="Expert 8-15\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 3", fillcolor=lightpink];
            
            // Expert 0-7 on GPU 4
            expert0_gpu4 [label="Expert 0-7\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 4", fillcolor=lightpink];
            
            // Expert 8-15 on GPU 5
            expert8_gpu5 [label="Expert 8-15\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 5", fillcolor=lightpink];
            
            // Expert 0-7 on GPU 6
            expert0_gpu6 [label="Expert 0-7\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 6", fillcolor=lightpink];
            
            // Expert 8-15 on GPU 7
            expert8_gpu7 [label="Expert 8-15\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 7", fillcolor=lightpink];
        }
        
        // Expert aggregation
        expert_agg0_s0 [label="Expert Aggregation\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", shape=parallelogram, fillcolor=lightcyan];
        
        // Final residual
        residual1_0_s0 [label="Residual Add\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightgray];
    }
    
    // Pipeline communication to Stage 1
    pipe_comm_0_1 [label="Pipeline Communication\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7 → 8-15", shape=ellipse, fillcolor=orange];
    
    // Layer 0 - Stage 1 (GPUs 8-15)
    subgraph cluster_layer0_stage1 {
        label="Layer 0 - Stage 1 (GPUs 8-15)";
        style=dashed;
        
        ln0_s1 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 8-15", fillcolor=lightyellow];
        
        // Similar structure for remaining layers...
        // For brevity, showing the pattern for all 4 layers
    }
    
    // Layer 1 - Stage 0
    subgraph cluster_layer1_stage0 {
        label="Layer 1 - Stage 0 (GPUs 0-7)";
        style=dashed;
        
        ln1_s0 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightyellow];
        // ... (similar structure as layer 0)
    }
    
    // Layer 2 - Stage 0
    subgraph cluster_layer2_stage0 {
        label="Layer 2 - Stage 0 (GPUs 0-7)";
        style=dashed;
        
        ln2_s0 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightyellow];
        // ... (similar structure as layer 0)
    }
    
    // Layer 3 - Stage 0
    subgraph cluster_layer3_stage0 {
        label="Layer 3 - Stage 0 (GPUs 0-7)";
        style=dashed;
        
        ln3_s0 [label="LayerNorm\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: 0-7", fillcolor=lightyellow];
        // ... (similar structure as layer 0)
    }
    
    // Output
    output [label="Output\nInput: [batch_size=1024, seq_len=10000, token_dim=8192]\nOutput: [batch_size=1024, seq_len=10000, token_dim=8192]\nGPU: all GPUs", shape=ellipse, fillcolor=lightblue];
    
    // Connections
    input -> ln0_s0;
    ln0_s0 -> mha_q0_s0;
    ln0_s0 -> mha_k0_s0;
    ln0_s0 -> mha_v0_s0;
    mha_q0_s0 -> attn0_s0;
    mha_k0_s0 -> attn0_s0;
    mha_v0_s0 -> attn0_s0;
    attn0_s0 -> mha_out0_s0;
    mha_out0_s0 -> residual0_s0;
    input -> residual0_s0 [style=dashed];
    residual0_s0 -> ln1_0_s0;
    ln1_0_s0 -> expert0_gpu0;
    ln1_0_s0 -> expert8_gpu1;
    ln1_0_s0 -> expert0_gpu2;
    ln1_0_s0 -> expert8_gpu3;
    ln1_0_s0 -> expert0_gpu4;
    ln1_0_s0 -> expert8_gpu5;
    ln1_0_s0 -> expert0_gpu6;
    ln1_0_s0 -> expert8_gpu7;
    
    expert0_gpu0 -> expert_agg0_s0;
    expert8_gpu1 -> expert_agg0_s0;
    expert0_gpu2 -> expert_agg0_s0;
    expert8_gpu3 -> expert_agg0_s0;
    expert0_gpu4 -> expert_agg0_s0;
    expert8_gpu5 -> expert_agg0_s0;
    expert0_gpu6 -> expert_agg0_s0;
    expert8_gpu7 -> expert_agg0_s0;
    
    expert_agg0_s0 -> residual1_0_s0;
    residual0_s0 -> residual1_0_s0 [style=dashed];
    residual1_0_s0 -> pipe_comm_0_1;
    
    // Continue pattern for all layers...
    pipe_comm_0_1 -> output;
}