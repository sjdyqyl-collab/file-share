digraph Baseline_MoE_Deployment {
    rankdir=TB;
    splines=ortho;
    nodesep=0.5;
    ranksep=1.2;
    
    // Input node
    input [label="Total Input\nbatch_size=1024\nseq_len=10000\ntoken_dim=8192", shape=parallelogram, fillcolor=lightgreen];
    
    // Output node
    output [label="Total Output\nbatch_size=1024\nseq_len=10000\ntoken_dim=8192", shape=parallelogram, fillcolor=lightgreen];
    
    // Layer 0 - GPU 0
    L0_GPU0_mha_qkv [label="MHA QKV Linear\nGPU: 0", shape=rectangle, fillcolor=yellow];
    L0_GPU0_mha_attn [label="MHA Attention\nGPU: 0", shape=rectangle, fillcolor=yellow];
    L0_GPU0_mha_residual [label="MHA Residual\nGPU: 0", shape=ellipse, fillcolor=lightcoral];
    L0_GPU0_gate [label="Expert Gate\nGPU: 0", shape=diamond, fillcolor=orange];
    L0_GPU0_expert_0 [label="Expert 0\nGPU: 0", shape=rectangle, fillcolor=lightblue];
    L0_GPU0_expert_1 [label="Expert 1\nGPU: 0", shape=rectangle, fillcolor=lightblue];
    L0_GPU0_expert_2 [label="Expert 2\nGPU: 0", shape=rectangle, fillcolor=lightblue];
    L0_GPU0_expert_3 [label="Expert 3\nGPU: 0", shape=rectangle, fillcolor=lightblue];
    L0_GPU0_expert_agg [label="Expert Aggregation\nGPU: 0", shape=hexagon, fillcolor=lightgreen];
    L0_GPU0_final_residual [label="Final Residual\nGPU: 0", shape=ellipse, fillcolor=lightcoral];
    
    // Layer 0 - GPU 1
    L0_GPU1_expert_4 [label="Expert 4-7\nGPU: 1", shape=rectangle, fillcolor=lightblue];
    
    // Layer 0 - GPU 2-3
    L0_GPU2_expert_8 [label="Expert 8-11\nGPU: 2", shape=rectangle, fillcolor=lightblue];
    L0_GPU3_expert_12 [label="Expert 12-15\nGPU: 3", shape=rectangle, fillcolor=lightblue];
    
    // Layer 1 - GPU 0
    L1_GPU0_mha_qkv [label="MHA QKV Linear\nGPU: 0", shape=rectangle, fillcolor=yellow];
    L1_GPU0_expert_agg [label="Expert Aggregation\nGPU: 0", shape=hexagon, fillcolor=lightgreen];
    L1_GPU0_final_residual [label="Final Residual\nGPU: 0", shape=ellipse, fillcolor=lightcoral];
    
    // Layer 2 - GPU 8
    L2_GPU8_mha_qkv [label="MHA QKV Linear\nGPU: 8", shape=rectangle, fillcolor=yellow];
    L2_GPU8_expert_32 [label="Expert 32-35\nGPU: 8", shape=rectangle, fillcolor=lightblue];
    L2_GPU8_final_residual [label="Final Residual\nGPU: 8", shape=ellipse, fillcolor=lightcoral];
    
    // Layer 3 - GPU 15
    L3_GPU15_mha_qkv [label="MHA QKV Linear\nGPU: 15", shape=rectangle, fillcolor=yellow];
    L3_GPU15_expert_60 [label="Expert 60-63\nGPU: 15", shape=rectangle, fillcolor=lightblue];
    L3_GPU15_final_residual [label="Final Residual\nGPU: 15", shape=ellipse, fillcolor=lightcoral];
    
    // Connections
    input -> L0_GPU0_mha_qkv;
    
    L0_GPU0_mha_qkv -> L0_GPU0_mha_attn -> L0_GPU0_mha_residual -> L0_GPU0_gate;
    L0_GPU0_gate -> L0_GPU0_expert_0 [style=dashed];
    L0_GPU0_gate -> L0_GPU0_expert_1 [style=dashed];
    L0_GPU0_gate -> L0_GPU0_expert_2 [style=dashed];
    L0_GPU0_gate -> L0_GPU0_expert_3 [style=dashed];
    L0_GPU0_mha_residual -> L0_GPU0_expert_0;
    L0_GPU0_mha_residual -> L0_GPU0_expert_1;
    L0_GPU0_mha_residual -> L0_GPU0_expert_2;
    L0_GPU0_mha_residual -> L0_GPU0_expert_3;
    L0_GPU0_expert_0 -> L0_GPU0_expert_agg;
    L0_GPU0_expert_1 -> L0_GPU0_expert_agg;
    L0_GPU0_expert_2 -> L0_GPU0_expert_agg;
    L0_GPU0_expert_3 -> L0_GPU0_expert_agg;
    L0_GPU0_expert_agg -> L0_GPU0_final_residual;
    L0_GPU0_mha_residual -> L0_GPU0_final_residual;
    
    L0_GPU0_final_residual -> L1_GPU0_mha_qkv;
    L1_GPU0_final_residual -> L2_GPU8_mha_qkv;
    L2_GPU8_final_residual -> L3_GPU15_mha_qkv;
    L3_GPU15_final_residual -> output;
}