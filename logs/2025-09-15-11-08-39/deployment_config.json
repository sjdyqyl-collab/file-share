      },
      "memory_requirements": {
        "activation_memory_per_device": "(L/P) * B * d_model = 625 * 1024 * 8192 bytes",
        "parameter_memory_per_device": "total_params",
        "communication_buffer": "B * (L/P) * d_model * 2 = 10.24 MB per buffer"
      }
    }
