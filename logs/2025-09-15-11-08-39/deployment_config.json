          "device_6": {"tokens": [3750, 4374]},
          "device_7": {"tokens": [4375, 4999]},
          "device_8": {"tokens": [5000, 5624]},
          "device_9": {"tokens": [5625, 6249]},
          "device_10": {"tokens": [6250, 6874]},
          "device_11": {"tokens": [6875, 7499]},
          "device_12": {"tokens": [7500, 8124]},
          "device_13": {"tokens": [8125, 8749]},
          "device_14": {"tokens": [8750, 9374]},
          "device_15": {"tokens": [9375, 9999]}
        }
      },
      "communication_specifications": {
        "protocol": "NCCL_send_recv",
        "buffer_size": "B * (L/P) * d_model = 1024 * 625 * 8192 bytes",
        "precision": "fp16",
        "overlap": {
