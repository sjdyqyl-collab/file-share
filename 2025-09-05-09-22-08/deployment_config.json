{
  "baseline_deployment": {
    "name": "TP8_PP2_Baseline",
    "description": "Baseline deployment with Tensor Parallelism 8 and Pipeline Parallelism 2",
    "parallel_strategy": {
      "type": "hybrid",
      "tensor_parallelism": {
        "degree": 8,
        "method": "megatron_lm",
        "parameters": {
          "all_reduce_in_fp16": true,
          "sequence_parallel": false
        }
      },
      "pipeline_parallelism": {
        "degree": 2,
        "method": "gpipe",
        "parameters": {
          "micro_batch_size": 512,
          "chunks": 2
        }
      },
      "expert_parallelism": {
        "degree": 1,
        "method": "colocated_experts",
        "parameters": {
          "experts_per_gpu": 4
        }
      }
    },
    "modules": {
      "attention_layer": {
        "type": "multi_head_attention",
        "parameters": {
          "num_heads": 16,
          "head_dim": 512,
          "hidden_size": 8192,
          "precision": "fp16"
        },
        "parallel_config": {
          "tensor_parallel": true,
          "pipeline_parallel": true,
          "expert_parallel": false
        }
      },
      "mlp_expert": {
        "type": "mlp",
        "parameters": {
          "hidden_size": 32768,
          "activation": "gelu",
          "precision": "fp16"
        },
        "parallel_config": {
          "tensor_parallel": true,
          "pipeline_parallel": true,
          "experts_per_gpu": 4
        }
      },
      "gate_network": {
        "type": "topk_gating",
        "parameters": {
          "k": 2,
          "capacity_factor": 1.0,
          "aux_loss_weight": 0.01
        },
        "parallel_config": {
          "tensor_parallel": false,
          "pipeline_parallel": true,
          "expert_parallel": false
        }
      }
    },
    "device_mapping": {
      "total_gpus": 16,
      "gpu_type": "H100",
      "topology": {
        "nodes": 2,
        "gpus_per_node": 8,
        "interconnect": "nvlink"
      },
      "mapping_strategy": [
        {
          "node_id": 0,
          "gpus": [0, 1, 2, 3, 4, 5, 6, 7],
          "pipeline_stage": 0,
          "experts_per_gpu": 4,
          "tensor_parallel_group": [0, 1, 2, 3, 4, 5, 6, 7]
        },
        {
          "node_id": 1,
          "gpus": [0, 1, 2, 3, 4, 5, 6, 7],
          "pipeline_stage": 1,
          "experts_per_gpu": 4,
          "tensor_parallel_group": [0, 1, 2, 3, 4, 5, 6, 7]
        }
      ]
    },
    "batch_config": {
      "global_batch_size": 1024,
      "micro_batch_size": 512,
      "sequence_length": 2048
    }
  },
  "proposed_deployment": {
    "name": "Large_EP_Cross_Node",
    "description": "Proposed large-scale cross-node expert parallelism with one expert per GPU",
    "parallel_strategy": {
      "type": "expert_parallelism_first",
      "expert_parallelism": {
        "degree": 64,
        "method": "one_expert_per_gpu",
        "parameters": {
          "topology_aware_placement": true,
          "max_experts_per_gpu": 1,
          "cross_node_distribution": true
        }
      },
      "tensor_parallelism": {
        "degree": 1,
        "method": "optional",
        "parameters": {
          "enable_when_needed": true,
          "max_degree": 2,
          "condition": "expert_size_exceeds_gpu_memory"
        }
      },
      "pipeline_parallelism": {
        "degree": 4,
        "method": "micro_stages",
        "parameters": {
          "layer_per_stage": 1,
          "overlap_communication": true,
          "asynchronous_token_routing": true
        }
      }
    },
    "modules": {
      "attention_layer": {
        "type": "multi_head_attention",
        "parameters": {
          "num_heads": 16,
          "head_dim": 512,
          "hidden_size": 8192,
          "precision": "fp16"
        },
        "parallel_config": {
          "tensor_parallel": false,
          "pipeline_parallel": true,
          "expert_parallel": false,
          "placement": "replicated_across_dp_groups"
        }
      },
      "mlp_expert": {
        "type": "mlp",
        "parameters": {
          "hidden_size": 32768,
          "activation": "gelu",
          "precision": "fp16"
        },
        "parallel_config": {
          "tensor_parallel": "optional_2_way",
          "pipeline_parallel": false,
          "expert_parallel": true,
          "placement": "one_per_gpu"
        }
      },
      "gate_network": {
        "type": "topk_gating",
        "parameters": {
          "k": 2,
          "capacity_factor": 1.0,
          "aux_loss_weight": 0.01,
          "load_balancing": "dynamic"
        },
        "parallel_config": {
          "tensor_parallel": false,
          "pipeline_parallel": false,
          "expert_parallel": false,
          "placement": "replicated"
        }
      },
      "token_router": {
        "type": "asynchronous_router",
        "parameters": {
          "batch_tokens_by_destination": true,
          "overlap_compute_comm": true,
          "cuda_streams": 4,
          "nccl_backend": true
        }
      }
    },
    "device_mapping": {
      "total_gpus": 64,
      "gpu_type": "H100",
      "topology": {
        "nodes": 8,
        "gpus_per_node": 8,
        "interconnect": "nvlink_intra_node",
        "inter_node": "infiniband"
      },
      "expert_placement": {
