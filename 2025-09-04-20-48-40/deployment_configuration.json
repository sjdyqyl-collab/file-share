{
  "models": {
    "baseline": {
      "name": "Baseline MoE (TP=8, PP=2)",
      "parallel_strategy": {
        "type": "hybrid",
        "tensor_parallelism": {
          "degree": 8,
          "partitions": ["attention_heads", "mlp_hidden"]
        },
        "pipeline_parallelism": {
          "degree": 2,
          "stages": 2,
          "micro_batches": 1
        },
        "expert_parallelism": {
          "degree": 1,
          "experts_per_gpu": 4
        }
      },
      "modules": {
        "attention_layer": {
          "type": "multi_head_attention",
          "heads": 16,
          "head_dim": 512,
          "total_dim": 8192,
          "tp_shards": 8,
          "devices_per_shard": 1
        },
        "moe_layer": {
          "type": "mixture_of_experts",
          "experts_per_layer": 16,
          "experts_per_gpu": 4,
          "expert_type": "mlp",
          "mlp_hidden": 32768,
          "activation": "silu",
          "tp_shards": 8,
          "devices_per_shard": 1
        },
        "routing": {
          "type": "top_k_gating",
          "k": 2,
          "load_balancing_loss": true
        }
      },
      "device_mapping": {
        "total_gpus": 16,
        "gpu_0_to_7": {
          "stage": 0,
          "experts": [0, 1, 2, 3],
          "tp_rank": [0, 1, 2, 3, 4, 5, 6, 7]
